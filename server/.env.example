# Backend HTTP port
PORT=3000

# Where PGlite (embedded PostgreSQL) keeps its data files.
# Set to "." to run in-memory (tests). Uses a .pgdata directory by default.
DATA_DIR=.pgdata

# Secret used to sign login tokens (HMAC-SHA256). Change in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins (Vite dev/preview).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173